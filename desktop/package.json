{
  "name": "tolgaperde-desktop",
  "version": "0.1.2",
  "description": "Tolga Perde - Windows masaüstü uygulaması",
  "main": "main.js",
  "author": "Tolga Perde",
  "repository": {
    "type": "git",
    "url": "https://github.com/taLhaaktrk/TolgaPerde.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tolgaperde.desktop",
    "productName": "TolgaPerde",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "../assets/logo.png"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "TolgaPerde_Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "taLhaaktrk",
      "repo": "TolgaPerde",
      "releaseType": "release"
    }
  }
}
